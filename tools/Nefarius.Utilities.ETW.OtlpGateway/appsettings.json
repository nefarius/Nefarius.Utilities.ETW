{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Kestrel": {
    "Endpoints": {
      "OtlpHttp": {
        "Url": "http://0.0.0.0:4318",
        "Protocols": "Http1AndHttp2"
      },
      "OtlpGrpc": {
        "Url": "http://0.0.0.0:4317",
        "Protocols": "Http2"
      }
    }
  },
  "Gateway": {
    "RequireAuthorization": false,
    "Export": {
      "Endpoint": "",
      "QueueCapacity": 1024,
      "MaxAttempts": 5
    },
    "Wpp": {
      "PdbFiles": [],
      "PdbDirectories": [],
      "TmfDirectories": [],
      "RewriteProviderName": false,
      "SymbolServer": "",
      "SymbolCache": "",
      "SymbolRequestTimeout": "00:00:30"
    },
    "Limits": {
      "MaxRequestBodyBytes": 16777216,
      "MaxFrameBytes": 1048576,
      "MaxSessions": 1024,
      "MaxSessionsPerTenant": 32,
      "MaxRecordsPerRequest": 10000,
      "SessionIdleTimeout": "00:15:00"
    }
  }
}
