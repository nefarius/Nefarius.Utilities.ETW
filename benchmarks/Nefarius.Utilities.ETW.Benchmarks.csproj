<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>CS8892</NoWarn>
        <IsPackable>false</IsPackable>
        <!-- The test project reference pulls Microsoft.Testing.Platform transitively. This project is a benchmark host. -->
        <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\src\Nefarius.Utilities.ETW.csproj" />
      <ProjectReference Include="..\tests\Nefarius.Utilities.ETW.Tests.csproj" />
    </ItemGroup>

</Project>
